#!/usr/bin/env bash
# nb-secrets - keep secrets in passphrase-encrypted files (age) and hand them to commands
#
# Usage: nb-secrets <command> [options]
# Also runs as: nb secrets <command> [options]   (through the nb command, nb 0.15.0 or later)
#
# Commands:
#   run <file.age> -- <command> [args...]    run <command> with the variables exported to it only
#   list [<file.age>]                        list the files, or the variable names in one
#   set <file.age> <NAME>                    add or replace one variable
#   delete <file.age> <NAME>                 remove one variable
#   passwd <file.age>                        change the file's passphrase
#   compare <old-shell-file> <file.age>      check a migration by hash (no value is printed)
#   doctor                                   check the setup without decrypting
#   --install [DIR]                          link this script into DIR (default ~/.local/bin)
#   --uninstall [DIR]                        remove that link (only a link to this script)
#   --complete [WORD...]                     print the tab-completion candidates (the last WORD is the one being typed)
#
# Options:
#   run --only NAME[,NAME...]                pass just those variables
#   list --stale DAYS                        flag variables older than DAYS or undated (exit 1)
#   -h, --help                               show this help (with no command: the usage, exit 1)
#   --version                                show the version
#
# A secret file is a shell env file (`export NAME='value'` lines, `#` comments) encrypted with
# `age -p` (passphrase, no key file). It lives under $NB_SECRETS_DIR (default ~/.secrets,
# mode 700, files 600). Every command that decrypts asks for the passphrase on the terminal.
#
# Create a file without the plaintext ever touching the disk (paste the lines, then Ctrl-D):
#   age -p -o ~/.secrets/deploy.env.age
#
# run      decrypt in memory and run <command> with the variables exported to it only; nothing
#          is written to disk or left in the calling shell. --only passes just the named
#          variables (least privilege) and stops before running if one is not in the file.
#          Stops if decryption fails or the file is empty, so a wrong passphrase never runs
#          the command with empty values.
# list     without a file: the .age files in $NB_SECRETS_DIR (no passphrase needed).
#          with a file: the variable names inside it with the date `set` last wrote each one
#          (values are never shown; "-" = written before dates were recorded).
#          --stale DAYS also flags variables older than DAYS or undated and exits 1.
# set      add NAME or replace it. The value is asked for on the terminal (hidden, not in
#          shell history or `ps`) or read from the first line of stdin when piped. The line
#          gets a trailing `# updated=YYYY-MM-DD` comment (ignored when the file is sourced).
#          A new file is created if <file.age> does not exist.
# delete   remove NAME after a y/N confirmation.
# passwd   change the file's passphrase: current one, the new one twice, then the new one
#          once more to prove it was typed as intended. The file is replaced only if the
#          re-read content equals the original. Save the new passphrase in your password
#          manager at once: it is the only key to the file.
# compare  per variable of <file.age>: OK / DIFF / MISSING-IN-OLD against the old shell file
#          (SHA-256 of the values; no value is printed). Use it to prove a migration to an
#          encrypted file lost nothing. The old file is executed as shell code (`source`).
# --install  put `nb-secrets` on your PATH: a symlink to this script in DIR (default ~/.local/bin,
#          created if missing), so a `git pull` of this repository updates it. Nothing is
#          copied, no shell file is edited, no passphrase or terminal is needed. It does not
#          replace anything it did not make: if DIR already holds a file or a link to
#          somewhere else, it stops and says so. If DIR is not on your PATH it prints the line to add.
# --uninstall  remove that link from DIR (default ~/.local/bin). It removes only a link that points to this script, never a file or
#          another program's link, and says so when there is nothing to remove. Your encrypted files are not touched.
# doctor   check the setup without decrypting (no passphrase, no tty): age installed, the
#          directory mode 700 and files 600, no stray plaintext or leftover .age.new, no
#          ~/.secrets.env, Claude Code settings deny reading the directory and running age
#          (only if ~/.claude/settings.json exists), git does not store credentials in
#          plaintext (credential.helper=store). Exits 1 if anything is flagged.
#
# There is deliberately no `get`: a value on screen ends up in terminal logs and screen shares.
# To check a value, compare it with its source instead (`nb-secrets compare`).
#
# Safety:
#   - commands that decrypt refuse to run without an interactive terminal
#   - the new file is written next to the old one and moved over it only on success, so a
#     failure leaves the original untouched; files end up with mode 600
#   - values are never printed and never passed as command-line arguments
#   - when re-encrypting (set / delete) age asks for the passphrase again: use the file's
#     usual one, otherwise the file's passphrase changes (`passwd` is the way to change it)
#   - NAME must be a plain variable name; PATH / HOME / SHELL / USER are refused
#   - this is protection against accidents and casual reads, not against an attacker who
#     already runs as you (see README.md, "Limits")
#
# Environment: NB_SECRETS_DIR (default ~/.secrets)
set -euo pipefail

VERSION="0.1.0"
SELF="${BASH_SOURCE[0]}"

# Layout (the same in nb, nb-secrets and nb-quickstarts): Usage first, then one description line, "<emoji> NASEBANAL <Name> -
# <what it does>", then Commands and Options. The description is the first comment line above, so `nb -h` (which reads it
# without running anything) and this text cannot differ. When the nb command runs this tool (`nb secrets ...`, which
# sets NB_PLUGIN_NAME) the name shown is the one the user typed.
help() {
  local desc text
  desc=$(sed -n '2s/^# nb-secrets - //p' "$SELF")
  text=$(sed -n '3,/^set -euo pipefail/{/^set -euo pipefail/!p;}' "$SELF" | sed 's/^# \{0,1\}//' |
    awk -v t="🔐 NASEBANAL Secrets - $desc" 'NR == 1 && $0 == "" { next } /^Commands:/ && !done { print t; print ""; done = 1 } { print }')
  if [ "${NB_PLUGIN_NAME-}" = "nb secrets" ]; then
    text=$(printf '%s\n' "$text" | sed -e '/^Also runs as:/d' -e 's/nb-secrets/nb secrets/g')
  fi
  printf '%s\n' "$text"
}
usage() { help | sed -n '1,/^A secret file/{/^A secret file/!p;}' >&2; exit 1; }
die() { echo "$*" >&2; exit 1; }

dir_default() { printf '%s' "${NB_SECRETS_DIR:-$HOME/.secrets}"; }
need_tty() { [ -t 2 ] || die "nb-secrets needs an interactive terminal (passphrase prompt); refusing to run"; }
need_tty_in() { { [ -t 0 ] && [ -t 2 ]; } || die "nb-secrets run needs an interactive terminal (passphrase prompt); refusing to run"; }
need_age() { command -v age >/dev/null || die "age is not installed (brew install age)"; }
check_name() {
  case "$1" in PATH|HOME|SHELL|USER) die "refusing to store $1 in a secret file" ;; esac
  printf '%s' "$1" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*$' || die "invalid variable name: $1"
}
sha256() { if command -v shasum >/dev/null; then shasum -a 256; else sha256sum; fi | cut -c1-64; }

# Variable names defined by decrypted text on stdin (`KEY=` or `export KEY=`), one per line, unique.
plain_names() { sed -nE 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=.*/\2/p' | sort -u; }
has_name() { printf '%s\n' "$1" | grep -Eq "^[[:space:]]*(export[[:space:]]+)?$2="; }
without_name() { printf '%s\n' "$1" | grep -Ev "^[[:space:]]*(export[[:space:]]+)?$2=" || true; }

# "  NAME  <date>" per variable on stdin; the date is the `# updated=YYYY-MM-DD` mark that `set`
# writes at the end of the line ("-" for lines written without it). With a day count as $1,
# also flags older / undated ones and exits 3 if there is any.
names_of() {
  awk -v stale="${1:-0}" -v today="$(date +%F)" '
    function jdn(t,   y, m, d, a, y2, m2) {
      y = substr(t, 1, 4) + 0; m = substr(t, 6, 2) + 0; d = substr(t, 9, 2) + 0
      a = int((14 - m) / 12); y2 = y + 4800 - a; m2 = m + 12 * a - 3
      return d + int((153 * m2 + 2) / 5) + 365 * y2 + int(y2 / 4) - int(y2 / 100) + int(y2 / 400) - 32045
    }
    {
      line = $0
      if (line !~ /^[ \t]*(export[ \t]+)?[A-Za-z_][A-Za-z0-9_]*=/) next
      sub(/^[ \t]*(export[ \t]+)?/, "", line)
      name = line; sub(/=.*/, "", name)
      d = "-"
      if ($0 ~ /  # updated=[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) { d = substr($0, length($0) - 9) }
      note = ""
      if (stale > 0) {
        if (d == "-") { note = "  <- no date"; flagged = 1 }
        else if (jdn(today) - jdn(d) > stale) { note = "  <- older than " stale " days"; flagged = 1 }
      }
      printf "  %-32s %s%s\n", name, d, note
    }
    END { exit flagged ? 3 : 0 }'
}

# Encrypt stdin to "$1.new", then move it over "$1".
write_file() {
  local f="$1" new="$1.new"
  trap 'rm -f "$new"' EXIT
  age -p -o "$new" || die "encrypt failed; file not changed"
  mv "$new" "$f"; chmod 600 "$f"
  trap - EXIT
}

cmd_run() {
  local only="" f plain names
  if [ "${1:-}" = "--only" ]; then
    [ "$#" -ge 2 ] || die "--only needs a comma-separated list of names"
    only="$2"; shift 2
    printf '%s' "$only" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*$' || die "invalid --only list: $only"
  fi
  [ "$#" -ge 1 ] || die "Usage: nb-secrets run [--only NAME,...] <file.age> -- <command> [args...]"
  f="$1"; shift
  [ "${1:-}" = "--" ] && shift
  [ "$#" -ge 1 ] || die "no command given (Usage: nb-secrets run [--only NAME,...] <file.age> -- <command> [args...])"
  need_tty_in
  [ -f "$f" ] || die "not found: $f"
  need_age
  # Decrypt into a variable first, so a failure is caught here. `source <(age -d ...)` would
  # swallow the error and run the command with the variables missing.
  plain=$(age -d "$f") || die "decrypt failed; command not run"
  [ -n "$plain" ] || die "decrypted file is empty; command not run"
  names=$(printf '%s\n' "$plain" | plain_names)
  # Subshell: the variables disappear when the command ends.
  (
    local_before=$(compgen -e | sort)
    set -a
    # shellcheck source=/dev/null
    source <(printf '%s\n' "$plain")
    set +a
    unset plain
    if [ -n "$only" ]; then
      IFS=, read -r -a want <<< "$only"
      for n in "${want[@]}"; do
        [ -n "${!n+x}" ] || { echo "--only: $n is not in $f; command not run" >&2; exit 1; }
      done
      local_after=$(compgen -e | sort)
      new=$(comm -13 <(printf '%s\n' "$local_before") <(printf '%s\n' "$local_after"))
      for n in $new $names; do
        case "$n" in PATH|HOME|SHELL|USER) continue ;; esac
        case ",$only," in *",$n,"*) ;; *) unset "$n" ;; esac
      done
    fi
    exec "$@"
  )
}

cmd_list() {
  local stale=0 f plain rc=0 dir found=0 x
  if [ "${1:-}" = "--stale" ]; then
    [ "$#" -ge 2 ] || usage
    printf '%s' "$2" | grep -Eq '^[0-9]+$' || die "--stale needs a number of days"
    stale="$2"; shift 2
  fi
  [ "$#" -le 1 ] || usage
  if [ "$#" -eq 0 ]; then
    [ "$stale" -eq 0 ] || die "--stale needs a file"
    dir=$(dir_default)
    for x in "$dir"/*.age; do
      [ -e "$x" ] || continue
      found=1; printf '%s\n' "$x"
    done
    [ "$found" -eq 1 ] || echo "no .age files in $dir" >&2
    return 0
  fi
  f="$1"
  need_tty; need_age
  [ -f "$f" ] || die "not found: $f"
  plain=$(age -d "$f") || die "decrypt failed"
  printf '%s\n' "$plain" | names_of "$stale" || rc=$?
  [ "$rc" -eq 0 ] || { echo "stale or undated variables found (--stale $stale)" >&2; exit 1; }
}

cmd_set() {
  [ "$#" -eq 2 ] || usage
  local f="$1" name="$2" plain="" value verb=added
  need_tty; need_age; check_name "$name"
  if [ -f "$f" ]; then
    plain=$(age -d "$f") || die "decrypt failed; file not changed"
  fi
  if [ -t 0 ]; then
    printf 'value for %s (hidden): ' "$name" >&2
    IFS= read -rs value
    printf '\n' >&2
  else
    IFS= read -r value || true
  fi
  [ -n "$value" ] || die "empty value; file not changed"
  if has_name "$plain" "$name"; then verb=replaced; plain=$(without_name "$plain" "$name"); fi
  {
    [ -n "$plain" ] && printf '%s\n' "$plain"
    printf 'export %s=%q  # updated=%s\n' "$name" "$value" "$(date +%F)"
  } | write_file "$f"
  unset value plain
  echo "$verb: $name -> $f" >&2
  echo "variables now in the file (names only):" >&2
  age -d "$f" | names_of >&2
}

cmd_delete() {
  [ "$#" -eq 2 ] || usage
  local f="$1" name="$2" plain rest ans
  need_tty; need_age; check_name "$name"
  [ -f "$f" ] || die "not found: $f"
  plain=$(age -d "$f") || die "decrypt failed; file not changed"
  has_name "$plain" "$name" || die "$name is not in $f; nothing to delete"
  printf 'delete %s from %s ? [y/N] ' "$name" "$f" >&2
  IFS= read -r ans </dev/tty
  case "$ans" in y|Y|yes) ;; *) die "cancelled; file not changed" ;; esac
  rest=$(without_name "$plain" "$name")
  [ -n "$rest" ] || die "that would leave the file empty; delete the file itself instead (rm $f)"
  printf '%s\n' "$rest" | write_file "$f"
  echo "deleted: $name from $f" >&2
  echo "variables now in the file (names only):" >&2
  age -d "$f" | names_of >&2
}

cmd_passwd() {
  [ "$#" -eq 1 ] || usage
  local f="$1" plain new check
  need_tty; need_age
  [ -f "$f" ] || die "not found: $f"
  echo "enter the CURRENT passphrase:" >&2
  plain=$(age -d "$f") || die "decrypt failed; file not changed"
  new="$f.new"
  trap 'rm -f "$new"' EXIT
  echo "enter the NEW passphrase (twice):" >&2
  printf '%s\n' "$plain" | age -p -o "$new" || die "encrypt failed; file not changed"
  echo "enter the NEW passphrase once more to verify:" >&2
  check=$(age -d "$new") || die "verification failed; file not changed"
  [ "$check" = "$plain" ] || die "verification mismatch; file not changed"
  mv "$new" "$f"; chmod 600 "$f"
  trap - EXIT
  echo "passphrase changed: $f  (save the new one in your password manager now)" >&2
}

# Print "NAME <sha256 | MISSING>" for each name in $names after sourcing file $1.
# The names are unset first, so a value already in the calling environment cannot leak in.
hashes_after_source() {
  (
    # The sourced file is the user's own shell code: do not let our strict mode abort it.
    set +e +u +o pipefail
    # shellcheck disable=SC2086
    unset $names
    saved_path=$PATH
    set -a
    # shellcheck disable=SC1090
    source "$1" >/dev/null 2>&1 || true
    set +a
    # SC2030: the restore is meant to stay in this subshell (the sourced file may have changed PATH).
    # shellcheck disable=SC2030
    PATH=$saved_path
    for n in $names; do
      if [ -n "${!n+x}" ]; then
        printf '%s %s\n' "$n" "$(printf '%s' "${!n}" | sha256)"
      else
        printf '%s MISSING\n' "$n"
      fi
    done
  )
}

cmd_compare() {
  [ "$#" -eq 2 ] || usage
  local old="$1" enc="$2" plain skip new_h old_h bad=0 n h oh
  need_tty; need_age
  [ -f "$old" ] || die "not found: $old"
  [ -f "$enc" ] || die "not found: $enc"
  plain=$(age -d "$enc") || die "decrypt failed"
  [ -n "$plain" ] || die "decrypted file is empty"
  names=$(printf '%s\n' "$plain" | plain_names)
  # PATH (and other shell basics) must never be compared or unset: this script needs them.
  for skip in PATH HOME SHELL USER; do
    if printf '%s\n' "$names" | grep -qx "$skip"; then
      echo "warning: $skip is defined in the encrypted file; skipped (keep it out of secret files)" >&2
      names=$(printf '%s\n' "$names" | grep -vx "$skip" || true)
    fi
  done
  [ -n "$names" ] || die "no KEY=value lines found in the encrypted file"
  echo "decrypted; comparing $(printf '%s\n' "$names" | wc -l | tr -d ' ') variable(s)..." >&2
  new_h=$(hashes_after_source <(printf '%s\n' "$plain")) || true
  unset plain
  old_h=$(hashes_after_source "$old") || true
  [ -n "$new_h" ] || die "could not read the variables from the encrypted file"
  [ -n "$old_h" ] || die "could not read the variables from the old file: $old"
  while read -r n h; do
    oh=$(printf '%s\n' "$old_h" | awk -v n="$n" '$1==n {print $2}')
    if [ "$oh" = "MISSING" ] || [ -z "$oh" ]; then
      printf '%-32s MISSING-IN-OLD\n' "$n"; bad=1
    elif [ "$oh" = "$h" ]; then
      printf '%-32s OK\n' "$n"
    else
      printf '%-32s DIFF\n' "$n"; bad=1
    fi
  done <<< "$new_h"
  return "$bad"
}

cmd_doctor() {
  [ "$#" -eq 0 ] || usage
  local dir bad=0 m n x rule cs
  dir=$(dir_default)
  ok()   { printf '  ok:   %s\n' "$*"; }
  warn() { printf '  WARN: %s\n' "$*"; bad=1; }
  mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }

  if command -v age >/dev/null; then ok "age installed ($(age --version 2>&1 | head -1))"; else warn "age is not installed (brew install age)"; fi

  if [ -d "$dir" ]; then
    m=$(mode "$dir")
    if [ "$m" = 700 ]; then ok "$dir is mode 700"; else warn "$dir is mode $m (chmod 700 $dir)"; fi
    n=0
    for x in "$dir"/* "$dir"/.[!.]*; do
      [ -e "$x" ] || continue
      case "${x##*/}" in
        *.age.new) warn "leftover temp file: $x (from a failed run; delete it)" ;;
        *.age) n=$((n + 1)); m=$(mode "$x"); [ "$m" = 600 ] || warn "$x is mode $m (chmod 600 $x)" ;;
        *) warn "not an .age file: $x (plaintext secrets must not live here)" ;;
      esac
    done
    ok "$n .age file(s) in $dir"
  else
    warn "$dir does not exist"
  fi

  if [ -e "$HOME/.secrets.env" ]; then warn "$HOME/.secrets.env exists (plaintext secrets file)"; else ok "no ~/.secrets.env"; fi

  cs="$HOME/.claude/settings.json"
  if [ -f "$cs" ]; then
    for rule in "Read($dir/**)" 'Bash(age:*)'; do
      rule_home=${rule//$HOME/\~}
      if grep -qF "$rule" "$cs" || grep -qF "$rule_home" "$cs"; then ok "Claude Code settings deny $rule_home"; else warn "Claude Code settings do not deny $rule_home (add it to permissions.deny in $cs)"; fi
    done
  else
    ok "no Claude Code settings found (skipped)"
  fi

  if [ "$(git config --global --get credential.helper 2>/dev/null || true)" = store ]; then
    warn "git credential.helper=store keeps credentials in plaintext (~/.git-credentials); use osxkeychain"
  else
    ok "git does not store credentials in plaintext"
  fi

  if [ "$bad" -eq 0 ]; then echo "all good" >&2; else echo "some checks need attention" >&2; fi
  return "$bad"
}

# The real path of a file, following symlinks (portable: no `readlink -f` on older macOS).
real_path() {
  local f="$1" d l
  while [ -L "$f" ]; do
    d=$(cd "$(dirname "$f")" && pwd); l=$(readlink "$f")
    case "$l" in /*) f="$l" ;; *) f="$d/$l" ;; esac
  done
  printf '%s/%s' "$(cd "$(dirname "$f")" && pwd)" "$(basename "$f")"
}

cmd_install() {
  [ "$#" -le 1 ] || usage
  local target="${1:-$HOME/.local/bin}" me link
  me=$(real_path "$SELF")
  link="$target/nb-secrets"
  mkdir -p "$target"
  if [ -L "$link" ] && [ "$(real_path "$link")" = "$me" ]; then
    echo "Already linked: $link -> $me"
  elif [ -e "$link" ] || [ -L "$link" ]; then
    die "$link already exists and is not a link to this script; remove it first if you want to replace it"
  else
    ln -s "$me" "$link"
    echo "Linked $link -> $me"
  fi
  # SC2031: the PATH change in cmd_compare lives in its own subshell; this reads the real one.
  # shellcheck disable=SC2031
  case ":$PATH:" in
    *":$target:"*) ;;
    *) echo "Note: $target is not on your PATH; add it (for example in ~/.zshrc): export PATH=\"$target:\$PATH\"" ;;
  esac
}

cmd_uninstall() {
  [ "$#" -le 1 ] || usage
  local target="${1:-$HOME/.local/bin}" me link
  me=$(real_path "$SELF")
  link="$target/nb-secrets"
  if [ -L "$link" ] && [ "$(real_path "$link")" = "$me" ]; then
    rm "$link"
    echo "Removed $link"
  elif [ -e "$link" ] || [ -L "$link" ]; then
    die "$link is not a link to this script: not removed"
  else
    echo "Nothing to remove: $link does not exist"
  fi
}

# Tab completion: `nb completion` runs `nb-secrets --complete <words...>` for `nb secrets <TAB>`. One candidate per
# line. It lists names only (the commands, the .age files in the secrets directory, the options): nothing is decrypted
# and no passphrase is asked.
cmd_complete() {
  local cur="${*: -1}" cmd="${1:-}" x
  [ "$#" -ge 1 ] || return 0
  {
    if [ "$#" -eq 1 ]; then
      printf '%s\n' run list set delete passwd compare doctor
    elif [[ "$cur" == -* ]]; then
      case "$cmd" in
        run)  printf '%s\n' --only ;;
        list) printf '%s\n' --stale ;;
      esac
    elif { [ "$#" -eq 2 ] && case "$cmd" in run|list|set|delete|passwd) true ;; *) false ;; esac; } ||
         { [ "$#" -eq 3 ] && [ "$cmd" = compare ]; }; then
      for x in "$(dir_default)"/*.age; do [ -e "$x" ] && printf '%s\n' "$x"; done
    fi
  } | awk -v p="$cur" 'index($0, p) == 1'
  return 0
}

case "${1:-}" in
  -h|--help|help) help; exit 0 ;;
  --version|version) echo "nb-secrets $VERSION"; exit 0 ;;
  --install) shift; cmd_install "$@"; exit 0 ;;
  --uninstall) shift; cmd_uninstall "$@"; exit 0 ;;
  --complete) shift; cmd_complete "$@"; exit 0 ;;
  "") usage ;;
esac
umask 077
cmd="$1"; shift
case "$cmd" in
  run)     cmd_run "$@" ;;
  list)    cmd_list "$@" ;;
  set)     cmd_set "$@" ;;
  delete)  cmd_delete "$@" ;;
  passwd)  cmd_passwd "$@" ;;
  compare) cmd_compare "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  *)       usage ;;
esac
